# ---- LLM ----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_JUDGE_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=            # 必填：你的 DeepSeek key（勿提交真实值）
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=120          # 单次 LLM 请求超时（秒），长 run 防被掐
LLM_MAX_RETRIES=3
LLM_CIRCUIT_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN=60

# ---- 多模态（可选）----
# 按模态配置凭证，不绑定供应商——用任意服务商的 Key 均可。
# 若模型自带环境变量引用（如自定义模型填 STABILITY_API_KEY），优先读对应 env。
VOLCENGINE_API_KEY=
OPENAI_API_KEY=
SUNO_API_KEY=

# ---- 鉴权（对外发布必开其一）----
AUTH_ENABLED=true            # 内网/受信发布：必须 true
AUTH_SECRET=                 # 留空则启动自动生成并持久化到 data/.auth_secret
AUTH_TOKEN_TTL_HOURS=24
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=         # 必填：首次启动 bootstrap 管理员密码
API_KEY_ENABLED=false
API_KEY=
PROJECT_ACCESS_ENABLED=false
# 开发态无鉴权时，若需 POST /api/adapters/register 请设为 true（生产勿开）
ALLOW_UNAUTH_ADAPTER_REGISTER=false
# 凭证 Fernet 加密密钥（与 AUTH_SECRET 二选一；勿用默认值上生产）
SECRET_KEY=

# ---- 服务 ----
HOST=0.0.0.0
PORT=8110
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 预算 / 可观测 ----
RUN_TOKEN_BUDGET=0
RUN_LLM_CALL_BUDGET=0
PROMETHEUS_ENABLED=true

# ---- PostgreSQL（生产可选，默认 SQLite）----
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # 生产环境务必设置；docker-compose scale 未设置时 postgres 拒绝启动
POSTGRES_DATABASE=agent_platform

# ---- 知识库 ----
KNOWLEDGE_BACKEND=chroma          # chroma（默认）| memory（回退）
CHROMA_PERSIST_DIR=./data/chroma  # Chroma 持久化目录

# ---- Redis / SSE 跨实例（可选）----
REDIS_HOST=localhost
REDIS_PORT=6379
SSE_REDIS_ENABLED=false

# ── Agent 节点超时（预算化，2026-08-08）──
# 节点超时 = 保底 + 工具循环轮数 × (LLM 单轮预算 + 工具预算) + 终稿预算，硬上限封顶。
# 让"正常+偶发慢"永不误杀，只有真卡死才被掐。默认 8 轮 → 1920s。
AGENT_TIMEOUT_SECONDS=300              # 保底（兼容旧配置语义）
LLM_TIMEOUT_SECONDS=120                # 每轮 LLM 单次调用预算
PER_ROUND_TOOL_BUDGET_SECONDS=60       # 每轮工具执行预算
FINAL_GEN_BUDGET_SECONDS=180           # 终稿长文生成预算
AGENT_TIMEOUT_CAP_SECONDS=3600         # 硬上限（防预算过大拖死 run）
